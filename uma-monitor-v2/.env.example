# Either an Alchemy key (URLs are built for Polygon mainnet)...
ALCHEMY_API_KEY=
# ...or explicit URLs (these win if set)
# POLYGON_HTTP_URL=https://polygon-mainnet.g.alchemy.com/v2/<key>
# POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/<key>

# Competition tracker (optional): free key from etherscan.io, covers Polygon via the V2 API
ETHERSCAN_API_KEY=

# Optional tuning (defaults shown)
# V2_CU_PER_SEC=240            # shared compute-unit budget for all HTTP calls
# V2_MIN_INTERVAL_MS=400       # minimum spacing between HTTP calls
# V2_LOG_CHUNK=10              # blocks per eth_getLogs (auto-shrinks if rejected)
# V2_CONFIRMATIONS=32          # blocks behind head before an event counts as confirmed
# V2_POLL_MS=15000             # confirmed-sync interval in live mode
# V2_START_BLOCK=              # first block when there is no checkpoint/imported data
# V2_DEFAULT_LOOKBACK=2000     # otherwise start this many blocks behind head
# V2_WHITELIST_REFRESH_MIN=60  # default whitelist re-snapshot interval
# V2_WHITELIST_CHECKS_PER_CYCLE=5
# V2_DISABLE_WS=0              # 1 = poll only, no WebSocket
# V2_DB=data/v2/monitor.sqlite
# V2_DASHBOARD_PORT=8787
# V2_ATTEMPTS_INTERVAL_MIN=5   # competition tracker interval in live mode
# V2_ETHERSCAN_RPS=4           # Etherscan free tier allows 5 calls/s
